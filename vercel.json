{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "buildCommand": "npm install --prefix server --no-audit --no-fund && npm install && npm run build"
}
