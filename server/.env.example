# IRIS backend configuration
#
# HOW TO USE THIS FILE
#   1. Copy it to `server/.env`   (same folder, drop the ".example")
#   2. Fill in the three ELEVENLABS_ values below
#   3. Restart the backend:  npm run server
#
# `server/.env` must NEVER be committed to git. It holds a billable API key.
# Everything here is read on the server only and is never sent to the browser.


# ── IRIS narration voice (ElevenLabs) ───────────────────────────────────────
# Leave these blank and IRIS still works: narration silently falls back to the
# browser's built-in voice. Fill them in to use your two chosen voices.

# Your ElevenLabs API key.
# Find it at: https://elevenlabs.io  →  profile icon (top right)  →  API Keys
ELEVENLABS_API_KEY=

# The two voice IDs. A voice ID is the ~20-character string in the voice's URL,
# or you can list every voice on your account by starting the backend and
# opening:  http://localhost:5000/api/tts/voices
#
# Pick your Arabic female voice for the first and your English female voice for
# the second. IRIS chooses between them automatically from the app's current
# language — Arabic screens use ELEVENLABS_VOICE_AR, English screens use
# ELEVENLABS_VOICE_EN. Nothing else needs configuring.
ELEVENLABS_VOICE_AR=
ELEVENLABS_VOICE_EN=

# Optional. The default handles both Arabic and English from one model, so
# there is normally no reason to change it.
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional. Only needed to route through a proxy or a mock during testing.
# ELEVENLABS_API_ROOT=https://api.elevenlabs.io/v1


# ── Content generation (Google Gemini) ──────────────────────────────────────
# OPTIONAL. Leave blank and IRIS works exactly as it does now: every practice
# activity is filled from the reviewed content bank, and /api/ai/status reports
# `configured: false`. Nothing in the learning loop depends on this — the
# adaptive engine assesses, adapts, records and explains with no model call.
#
# What it adds when configured: extra practice items at a difficulty the engine
# has ALREADY chosen, for the (skill × step × format) slots where the reviewed
# bank holds fewer than four items — 45 of 70 of them. Generated items are
# marked GENERATED_UNREVIEWED and are never treated as reviewed content.
#
# The key is read here, on the server, and is never sent to the browser.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.0-flash.
# GEMINI_MODEL=gemini-2.0-flash

# Optional. Ceiling on generation calls per minute, so a client-side loop
# cannot run up a bill. Defaults to 20.
# GEMINI_MAX_PER_MIN=20

# Optional. Upstream timeout in milliseconds. Defaults to 8000.
# GEMINI_TIMEOUT_MS=8000

# Optional. Only needed to route through a proxy or a mock during testing.
# GEMINI_API_ROOT=https://generativelanguage.googleapis.com/v1beta


# ── Existing settings (unchanged) ───────────────────────────────────────────
# PORT=5000
# CORS_ORIGIN=http://localhost:5175
